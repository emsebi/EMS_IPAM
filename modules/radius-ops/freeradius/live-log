# Volatile live-operator feed. FreeRADIUS emits best-effort datagrams only to
# localhost.  The supervisor keeps them in RAM for authenticated subscribers;
# there is no file/syslog/stdout credential destination and no back-pressure
# from the monitor into authentication.
linelog ems_live_accept {
 destination = udp
 udp {
  server = 127.0.0.1
  port = 18121
  timeout = 0.1
 }
 format = "AUTH|ACCEPT|%{hex:%{User-Name}}||%{hex:%{Packet-Src-IP-Address}}|%{hex:%{NAS-IP-Address}}|%{hex:%{NAS-Identifier}}|%{hex:%{Calling-Station-Id}}|%{hex:%{Called-Station-Id}}|%{hex:%{NAS-Port}}|%{hex:%{NAS-Port-Id}}|%{hex:%{control:Auth-Type}}|"
}
linelog ems_live_reject {
 destination = udp
 udp {
  server = 127.0.0.1
  port = 18121
  timeout = 0.1
 }
 format = "AUTH|REJECT|%{hex:%{User-Name}}|%{hex:%{User-Password}}|%{hex:%{Packet-Src-IP-Address}}|%{hex:%{NAS-IP-Address}}|%{hex:%{NAS-Identifier}}|%{hex:%{Calling-Station-Id}}|%{hex:%{Called-Station-Id}}|%{hex:%{NAS-Port}}|%{hex:%{NAS-Port-Id}}|%{hex:%{control:Auth-Type}}|%{hex:%{Module-Failure-Message}}"
}
linelog ems_live_accounting {
 destination = udp
 udp {
  server = 127.0.0.1
  port = 18121
  timeout = 0.1
 }
 format = "ACCT|%{Acct-Status-Type}|%{hex:%{User-Name}}||%{hex:%{Packet-Src-IP-Address}}|%{hex:%{NAS-IP-Address}}|%{hex:%{NAS-Identifier}}|%{hex:%{Calling-Station-Id}}|%{hex:%{Called-Station-Id}}|%{hex:%{NAS-Port}}|%{hex:%{NAS-Port-Id}}||"
}
