# Volatile live-operator feed. FreeRADIUS sends best-effort log datagrams only
# to the in-container loopback collector. The supervisor keeps decoded events
# in RAM only while an authenticated viewer is subscribed. No credential event
# is written to a file, PostgreSQL, syslog, stdout, or Docker logs.
linelog ems_live_accept {
 destination = udp
 format = "AUTH|ACCEPT|%{hex:%{User-Name}}||%{hex:%{Packet-Src-IP-Address}}|%{hex:%{NAS-IP-Address}}|%{hex:%{NAS-Identifier}}|%{hex:%{Calling-Station-Id}}|%{hex:%{Called-Station-Id}}|%{hex:%{NAS-Port}}|%{hex:%{NAS-Port-Id}}|%{hex:%{control:Auth-Type}}|"
 pool {
  start = 0
  min = 0
  max = 4
  spare = 1
  uses = 0
  retry_delay = 1
  lifetime = 0
  idle_timeout = 60
 }
 udp {
  server = "127.0.0.1"
  port = 18121
  timeout = 1.0
  pool = ${..pool}
 }
}
linelog ems_live_reject {
 destination = udp
 format = "AUTH|REJECT|%{hex:%{User-Name}}|%{hex:%{User-Password}}|%{hex:%{Packet-Src-IP-Address}}|%{hex:%{NAS-IP-Address}}|%{hex:%{NAS-Identifier}}|%{hex:%{Calling-Station-Id}}|%{hex:%{Called-Station-Id}}|%{hex:%{NAS-Port}}|%{hex:%{NAS-Port-Id}}|%{hex:%{control:Auth-Type}}|%{hex:%{Module-Failure-Message}}"
 pool {
  start = 0
  min = 0
  max = 4
  spare = 1
  uses = 0
  retry_delay = 1
  lifetime = 0
  idle_timeout = 60
 }
 udp {
  server = "127.0.0.1"
  port = 18121
  timeout = 1.0
  pool = ${..pool}
 }
}
linelog ems_live_accounting {
 destination = udp
 format = "ACCT|%{Acct-Status-Type}|%{hex:%{User-Name}}||%{hex:%{Packet-Src-IP-Address}}|%{hex:%{NAS-IP-Address}}|%{hex:%{NAS-Identifier}}|%{hex:%{Calling-Station-Id}}|%{hex:%{Called-Station-Id}}|%{hex:%{NAS-Port}}|%{hex:%{NAS-Port-Id}}||"
 pool {
  start = 0
  min = 0
  max = 4
  spare = 1
  uses = 0
  retry_delay = 1
  lifetime = 0
  idle_timeout = 60
 }
 udp {
  server = "127.0.0.1"
  port = 18121
  timeout = 1.0
  pool = ${..pool}
 }
}
